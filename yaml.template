# Offline training (TRAIN split only). scripts/train_comce.py writes new bundles; the published bundles are not retrained.
# U_tr per dataset (datasets.<d>.training), highest precedence first:
#   targets: <int>             the first <int> eligible targets of population_path
#   targets: all               every eligible target of population_path
#   target_fraction: <f>       the first round(f x |labeled_population|) targets of population_path
#   training.target_fraction   the same with the paper's 20% when the dataset sets neither (targets and target_fraction
#                              of one dataset are mutually exclusive)
# sampling_seed: null walks population_path in file order; an integer shuffles it with that seed first. Training stops
# when population_path shares a canonical target ID with any evaluation_populations entry.
training:
  seed: 20261017
  target_fraction: 0.2                # |U_tr| = 20% of the labeled vertices
  holdout_fraction: 0.2
  # The paper leaves the selector loss L({p_i}, M) unspecified; lambda_community and lambda_membership supervise
  # communities with witness-derived labels (0 keeps only witness coverage, size, entropy and slot diversity).
  selector: {epochs: 30, lr: 0.001, lambda_cover: 1.0, lambda_size: 0.2, lambda_community: 1.0, lambda_membership: 0.1,
             lambda_membership_entropy: 0.02, lambda_slot_diversity: 0.08}
  world_model: {epochs: 60, lr: 0.001, hidden: 64}
  # Reward R = lambda_flip p_omega - lambda_size |D|/B - lambda_div (1 - nov). imitation_epochs, bc_anchor_weight and
  # entropy_weight add terms outside that objective; 0 for all three trains on the reward alone (REINFORCE).
  # stop_aux_weight weights the Stop action in the teacher-forced terms (1.0 = plain cross-entropy over all actions).
  policy: {imitation_epochs: 8, reinforce_epochs: 8, rollouts: 8, lr: 0.001, entropy_weight: 0.01, lambda_flip: 1.0,
           lambda_size: 0.1, lambda_div: 0.1, bc_anchor_weight: 0.5, stop_aux_weight: 1.0}
  adaptation: {top_sets: 12, random_sets: 8, epochs: 40, lr: 0.0005, residual_epochs: 300, residual_lr: 0.01}
  # Optional update of omega (scripts/update_world_model.py), never applied unless run_comce.py is given the update:
  # omega_eff = omega + gate * delta. delta is fitted on real-GNN certification labels of TRAIN targets (BCE +
  # l2_weight ||delta||^2 + stability_weight BCE(p_eff, p_omega)); gate = 1 only when the validation BCE on held-out
  # TRAIN targets drops by more than min_improvement with at least min_validation_labels labels, else gate = 0.
  # These settings are engineering choices; the paper does not specify them.
  world_model_update: {epochs: 200, lr: 0.001, l2_weight: 0.001, stability_weight: 0.1, validation_fraction: 0.3,
                       min_validation_labels: 50, min_improvement: 0.005, seed: 20261017}

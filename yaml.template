# ComCE runtime and training configuration.
# Parameter precedence (highest first):
#   command line > tuples.<dataset>.<backbone> > datasets.<dataset> > dataset_defaults > paper_defaults
# Fields fixed by a model bundle (Set Transformer slots/heads/width, signature dimensions and buckets) must
# equal the bundle's architecture; a mismatch is an error, never a silent override.
# Every external path is empty: set the ones a task reads (data, explained GNN, ComCE bundle, signature bank,
# populations, outputs) before running it. A task that needs an empty path stops with ResourceConfigurationError
# naming the key, before anything is loaded.

paper_defaults:
  stage1:
    projection_dimensions: 8          # d_s fixed random directions shared by every node type
    quantile_buckets: 16              # buckets per coordinate; one bucketizer for every node type, fitted on TRAIN nodes only
    representation_dimension: 64      # d: every node type is encoded into this one space before the projection
    fit_split: train
  stage2:
    relevance_threshold: 0.10         # tau
    query_slots: 3                    # K
    attention_heads: 4
    hidden_width: 128
    domain_edge_cap: null             # Eq. (2): every community with p >= tau is admitted
  stage3:
    explanation_budget: 10            # B
    rollouts: 32                      # N_roll
    failure_threshold: 0.5            # tau_low
    failures_before_expansion: 4      # f_max
    expansion_budget: 8               # B_ext
    expansion_communities_per_trigger: 1   # Expand adds one community per trigger
    certification_queries: 9          # Q
    lookahead: 2                      # l
    cleanup_queries: 2                # Q_clean
    dedup_threshold: 0.9              # tau_dup, Jaccard-greedy RankDedup (skip if J > tau_dup)
    proposals_per_step: 1             # actions are sampled from pi_xi
    guidance_scale: 0.0
    temperature: 1.0

dataset_defaults:
  stage1:
    # Raw field -> representation x_v (encoder per field: sbert | lsh | precomputed | neighbor_mean) -> d_s shared
    # directions -> shared bucketizer. scripts/fit_signatures.py needs node_types and train_nodes and writes a template
    # of the data's node types and fields when they are missing; inference only loads the fitted bank.
    projection_seed: 20261017         # seed of the d_s shared random directions
    reducer: null                     # {method: pca} (fitted on TRAIN nodes) | {method: random_projection, seed: <int>}
    node_types: null
    train_nodes: null
  stage2:
    # Trade-off: a unique-edge cap on the admitted domain bounds the policy's action space; null restores Eq. (2).
    domain_edge_cap: null
    admission_exponent: 1.0           # under a cap: admission utility = p / (marginal edit cost) ** exponent
    fallback_min_domain_edges: 10     # soft fallback fills D_u up to this many edges (the paper gives no size); 10 = B
  stage3:
    # Trade-off: K policy proposals reweighted by exp(guidance_scale * S); proposals_per_step 1 or guidance_scale 0
    # samples pi_xi exactly as in the paper.
    proposals_per_step: 4
    guidance_scale: 0.5
    guidance_batch_size: 4
    expansion_communities_per_trigger: all   # Trade-off: admit every fitting community per trigger; 1 = paper
    temperature: 1.0                  # policy sampling temperature
    edit_cost: {mode: uniform, default_weight: 1.0}
  task:
    prediction: checkpoint            # checkpoint | positive_only
    min_receptive_edges_exclusive: null
    allowed_target_ids: null
  execution:
    device: cuda:0
    random_seed: 20260919
    threads: 1
    deterministic: true
    allow_tf32: false

resources:
  root: ""                            # paths below are absolute or relative to root (root: absolute or relative to this file)
  verify_checksums: true

outputs:
  root: ""                            # run results, Stage 1 templates and fitted banks (never inside the release)

datasets:
  claim:
    resources:
      data: ""                          # directory of the files below
      signature_bank: ""                # signature_bank.pt, with its feature_schema.json beside it
      populations:
        dev: ""
        confirm: ""
        dev_full: ""
        test1000: ""
        labeled: ""
      files:                            # SHA256 of files in the data directory
        graph.pt: 6d9367393b3edc4d689af6108025ae4c7b3a36e0de875f41bb9ab752730826ea
        SPLIT.pt: 3ada39586da222178bad4459bb740e5d1f34cd7a02a2bdb113c25dcb560c3829
    adapter:
      name: full_graph
      options:
        graph: graph.pt
        attribute_index: claim_attr
        node_types: [claim, beneficiary, provider, diagnosis_group]
        edge_types: [claim_beneficiary, claim_provider, claim_diagnosis_group]
        message_relations:
          - [claim, belongs_to_beneficiary, beneficiary]
          - [claim, submitted_to_provider, provider]
          - [claim, has_diagnosis_group, diagnosis_group]
          - [beneficiary, has_claim, claim]
          - [provider, serves_claim, claim]
          - [diagnosis_group, groups_claim, claim]
        graph_identity: b1759320e75c4748803ce9954273353294d20c6ad1b0aa9354e6eba223b7184f
        feature_schema_sha: 02a03b1d56797aad986035b6693cbed08ae39d48739d9cea6fcc28aae3018228
        gnn: {hidden: 64, layers: 3, dropout: 0.2, heads: 4}
    relations: [claim_beneficiary, claim_provider, claim_diagnosis_group]
    decision:
      kind: positive_to_negative
      num_classes: 2
      threshold: 0.5
      positive_class: 1
      deployment_temperature: 1.0
      class_vocabulary: [NotFraud, PotentialFraud]
    stage1:
      # Numeric attributes: TRAIN standardization and a seeded Gaussian random projection to d = 64 per node type.
      node_types:
        claim:
          fields:
            - {name: attributes, source: {file: graph.pt, key: x.claim}, encoder: lsh, input_kind: numeric_vector,
               standardize: train, output_dimension: 64, seed: 20261118}
        beneficiary:
          fields:
            - {name: attributes, source: {file: graph.pt, key: x.beneficiary}, encoder: lsh, input_kind: numeric_vector,
               standardize: train, output_dimension: 64, seed: 20261119}
        provider:
          fields:
            - {name: attributes, source: {file: graph.pt, key: x.provider}, encoder: lsh, input_kind: numeric_vector,
               standardize: train, output_dimension: 64, seed: 20261120}
        diagnosis_group:
          fields:
            - {name: attributes, source: {file: graph.pt, key: x.diagnosis_group}, encoder: lsh, input_kind: numeric_vector,
               standardize: train, output_dimension: 64, seed: 20261121}
      train_nodes:
        seed: {node_type: claim, source: {file: graph.pt, key: split}, equals: 0}   # native TRAIN split
        propagate:
          - [claim, claim_beneficiary, beneficiary]
          - [claim, claim_provider, provider]
          - [claim, claim_diagnosis_group, diagnosis_group]
    task:
      prediction: positive_only
    execution:
      random_seed: 20260919
    training:
      population_path: ""
      evaluation_populations: [dev, confirm, dev_full, test1000]
      sampling_seed: null
      labeled_population: labeled       # 30,000 labeled claims: U_tr = 6,000 under target_fraction 0.2
      targets: 80                       # protocol of the published bundles
      target_fraction: null
      supervision_sets: 24

  computer:
    resources:
      data: ""
      signature_bank: ""
      populations:
        dev: ""
        test: ""
        test1000: ""
      files:
        metadata.parquet: 78d6e32948b0d12e614e44027a851762f349b50645778f62a4f52b771a9e8663
        author_ids.pt: 54aca7c4ba574a472e5fa90c9d89f977a8ced67518255d598b6bd641664a6d74
        graph_arrays.npz: 225c8a342d86b412be5d06b83c8607d8d4048d39f8d63d5196f52da811451f38
        paper_inputs.npy: 0a623cd25001d9d209974ca44754d55b99971ff976474572602610e218ae59d7
        author_inputs.npy: c8d1e4473c62816ad67dcef4382867a093fde9a135b444afa9bb547329e3d2fe
    adapter:
      name: citation_graph
      options:
        metadata: metadata.parquet
        author_ids: author_ids.pt
        graph_arrays: graph_arrays.npz
        paper_inputs: paper_inputs.npy
        author_inputs: author_inputs.npy
    relations: [paper_cites_paper, paper_written_by_author]
    decision:
      kind: argmax_change
      num_classes: 34
      threshold: 0.5
      positive_class: 1

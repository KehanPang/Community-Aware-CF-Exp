# Fill in the empty paths ("") needed by the task you run. Paths are absolute or relative to resources.root;
# resources.root and outputs.root are absolute or relative to this file.

paper_defaults:
  stage1:
    projection_dimensions: 8
    quantile_buckets: 16
    representation_dimension: 64
    fit_split: train
  stage2:
    relevance_threshold: 0.10
    query_slots: 3
    attention_heads: 4
    hidden_width: 128
    domain_edge_cap: null
  stage3:
    explanation_budget: 10
    rollouts: 32
    failure_threshold: 0.5
    failures_before_expansion: 4
    expansion_budget: 8
    expansion_communities_per_trigger: 1
    certification_queries: 9
    lookahead: 2
    cleanup_queries: 2
    dedup_threshold: 0.9
    proposals_per_step: 1
    guidance_scale: 0.0
    temperature: 1.0

dataset_defaults:
  stage1:
    projection_seed: 20261017
    reducer: null
    node_types: null
    train_nodes: null
  stage2:
    domain_edge_cap: null
    admission_exponent: 1.0
    fallback_min_domain_edges: 10
  stage3:
    proposals_per_step: 4
    guidance_scale: 0.5
    guidance_batch_size: 4
    expansion_communities_per_trigger: all
    temperature: 1.0
    edit_cost: {mode: uniform, default_weight: 1.0}
  task:
    prediction: checkpoint
    min_receptive_edges_exclusive: null
    allowed_target_ids: null
  execution:
    device: cuda:0
    random_seed: 20260919
    threads: 1
    deterministic: true
    allow_tf32: false

resources:
  root: ""                  # base directory of the resource paths below

outputs:
  root: ""                  # directory for run results and fitted signature banks

datasets:
  claim:
    resources:
      data: ""              # dataset directory
      signature_bank: ""    # signature_bank.pt
      populations:          # target ID lists
        dev: ""
        confirm: ""
        dev_full: ""
        test1000: ""
        labeled: ""
    adapter:
      name: full_graph
      options:
        graph: graph.pt
        attribute_index: claim_attr
        node_types: [claim, beneficiary, provider, diagnosis_group]
        edge_types: [claim_beneficiary, claim_provider, claim_diagnosis_group]
        message_relations:
          - [claim, belongs_to_beneficiary, beneficiary]
          - [claim, submitted_to_provider, provider]
          - [claim, has_diagnosis_group, diagnosis_group]
          - [beneficiary, has_claim, claim]
          - [provider, serves_claim, claim]
          - [diagnosis_group, groups_claim, claim]
        gnn: {hidden: 64, layers: 3, dropout: 0.2, heads: 4}
    relations: [claim_beneficiary, claim_provider, claim_diagnosis_group]
    decision:
      kind: positive_to_negative
      num_classes: 2
      threshold: 0.5
      positive_class: 1
      deployment_temperature: 1.0
      class_vocabulary: [NotFraud, PotentialFraud]
    stage1:
      node_types:
        claim:
          fields:
            - {name: attributes, source: {file: graph.pt, key: x.claim}, encoder: lsh, input_kind: numeric_vector,
               standardize: train, output_dimension: 64, seed: 20261118}
        beneficiary:
          fields:
            - {name: attributes, source: {file: graph.pt, key: x.beneficiary}, encoder: lsh, input_kind: numeric_vector,
               standardize: train, output_dimension: 64, seed: 20261119}
        provider:
          fields:
            - {name: attributes, source: {file: graph.pt, key: x.provider}, encoder: lsh, input_kind: numeric_vector,
               standardize: train, output_dimension: 64, seed: 20261120}
        diagnosis_group:
          fields:
            - {name: attributes, source: {file: graph.pt, key: x.diagnosis_group}, encoder: lsh, input_kind: numeric_vector,
               standardize: train, output_dimension: 64, seed: 20261121}
      train_nodes:
        seed: {node_type: claim, source: {file: graph.pt, key: split}, equals: 0}
        propagate:
          - [claim, claim_beneficiary, beneficiary]
          - [claim, claim_provider, provider]
          - [claim, claim_diagnosis_group, diagnosis_group]
    task:
      prediction: positive_only
    execution:
      random_seed: 20260919
    training:
      population_path: ""   # TRAIN target ID list
      evaluation_populations: [dev, confirm, dev_full, test1000]
      sampling_seed: null
      labeled_population: labeled
      targets: 80
      target_fraction: null
      supervision_sets: 24

  computer:
    resources:
      data: ""              # dataset directory
      signature_bank: ""    # signature_bank.pt
      populations:          # target ID lists
        dev: ""
        test: ""
        test1000: ""
    adapter:
      name: citation_graph
      options:
        metadata: metadata.parquet
        author_ids: author_ids.pt
        graph_arrays: graph_arrays.npz
        paper_inputs: paper_inputs.npy
        author_inputs: author_inputs.npy
    relations: [paper_cites_paper, paper_written_by_author]
    decision:
      kind: argmax_change
      num_classes: 34
      threshold: 0.5
      positive_class: 1
      deployment_temperature: 1.0
    stage1:
      representation_dimension: 768
      node_types:
        paper:
          fields:
            - {name: text_embedding, source: {file: paper_text_embeddings.npy}, encoder: precomputed, output_dimension: 768}
        author:
          fields:
            - {name: papers, encoder: neighbor_mean, relation: [paper, paper_written_by_author, author], empty: zero}
      train_nodes:
        seed: {node_type: paper, source: {file: metadata.parquet, column: split}, equals: train}
        propagate:
          - [paper, paper_written_by_author, author]
    task:
      min_receptive_edges_exclusive: 200
    execution:
      random_seed: 20260910
    training:
      population_path: ""   # TRAIN target ID list
      evaluation_populations: [dev, test, test1000]
      sampling_seed: null
      targets: 300
      target_fraction: null
      supervision_sets: 32

  goodreads:
    resources:
      data: ""              # dataset directory
      signature_bank: ""    # signature_bank.pt
      train_centers: ""     # TRAIN target ID list used by train_nodes below
      populations:          # target ID lists
        dev: ""
        test1000: ""
    adapter:
      name: typed_graph
      options:
        graph: graph.pt
        target_type: book
        subgraph_layers: 4
        type_order: [book, review, user, author]
        canonical_relations:
          - [[book, book_has_review, review], book_has_review, false]
          - [[review, review_about_book, book], book_has_review, true]
          - [[user, user_writes_review, review], review_written_by_user, true]
          - [[review, review_written_by_user, user], review_written_by_user, false]
          - [[book, book_written_by_author, author], book_written_by_author, false]
          - [[author, author_writes_book, book], book_written_by_author, true]
        edge_endpoints:
          book_has_review: [book, review]
          review_written_by_user: [review, user]
          book_written_by_author: [book, author]
    relations: [book_has_review, review_written_by_user, book_written_by_author]
    decision:
      kind: argmax_change
      num_classes: 10
      threshold: 0.5
      positive_class: 1
      deployment_temperature: 1.0
    stage1:
      representation_dimension: 768
      node_types:
        book:
          fields:
            - {name: embedding, source: {file: book_features.npy}, encoder: precomputed, output_dimension: 768}
        review:
          fields:
            - {name: embedding, source: {file: review_features.npy}, encoder: precomputed, output_dimension: 768}
        user:
          fields:
            - {name: embedding, source: {file: user_features.npy}, encoder: precomputed, output_dimension: 768}
        author:
          fields:
            - {name: embedding, source: {file: author_features.npy}, encoder: precomputed, output_dimension: 768}
      train_nodes:
        seed: {node_type: book, source: {resource: train_centers}}
        propagate:
          - [book, book_has_review, review]
          - [review, review_written_by_user, user]
          - [book, book_written_by_author, author]
    stage3:
      temperature: 2.0
    execution:
      random_seed: 20260910
    training:
      population_path: ""   # TRAIN target ID list
      evaluation_populations: [dev, test1000]
      sampling_seed: null
      targets: 300
      target_fraction: null
      supervision_sets: 32


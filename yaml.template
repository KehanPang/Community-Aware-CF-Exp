      class_vocabulary_sha256: b49ce7c4afa983fe035b342d56cbf54e35a8c0715f088beecd50efa8b5699a9e
    stage1:
      representation_dimension: 768   # the published bank uses the existing 768-d embeddings as they are (no reducer)
      node_types:

training:
  seed: 20261017
  target_fraction: 0.2
  holdout_fraction: 0.2
  selector: {epochs: 30, lr: 0.001, lambda_cover: 1.0, lambda_size: 0.2, lambda_community: 1.0, lambda_membership: 0.1,
             lambda_membership_entropy: 0.02, lambda_slot_diversity: 0.08}
  world_model: {epochs: 60, lr: 0.001, hidden: 64}
  policy: {imitation_epochs: 8, reinforce_epochs: 8, rollouts: 8, lr: 0.001, entropy_weight: 0.01, lambda_flip: 1.0,
           lambda_size: 0.1, lambda_div: 0.1, bc_anchor_weight: 0.5, stop_aux_weight: 1.0}
  adaptation: {top_sets: 12, random_sets: 8, epochs: 40, lr: 0.0005, residual_epochs: 300, residual_lr: 0.01}
  world_model_update: {epochs: 200, lr: 0.001, l2_weight: 0.001, stability_weight: 0.1, validation_fraction: 0.3,
                       min_validation_labels: 50, min_improvement: 0.005, seed: 20261017}
